PORT=5000
DATABASE_URL=postgresql://user:password@localhost:5432/ai_data_intel
AI_SERVICE_URL=http://localhost:8000
NODE_ENV=development

# Demo data: DEMO_MODE=true forces demo sources always.
# ALLOW_DEMO_FALLBACK (default true locally, false in production via render.yaml)
# controls whether a run with ZERO real collected sources falls back to demo
# data or fails loudly. Set it to false to surface misconfiguration.
DEMO_MODE=false
ALLOW_DEMO_FALLBACK=true

# Live web discovery (Serper.dev free tier: 2500 queries)
SERPER_API_KEY=

# JWT signing - required, use a long random string. Startup fails in
# production if this is left at the development default.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Redis / background jobs
REDIS_URL=redis://localhost:6379
# "in-process" runs the BullMQ worker inside the API server (simplest to run).
# "separate" disables that and expects `npm run worker` as its own process.
WORKER_MODE=in-process
TASK_CONCURRENCY=3
TASK_MAX_ATTEMPTS=2

# Bounded parallelism (fast prototype profile: 2 queries x 1 page ≈ 10-14
# sources, ~3-6 min runs on the Groq 8000 TPM free tier)
FETCH_CONCURRENCY=4
EXTRACTION_CONCURRENCY=2
# Max Serper (query x page) calls per task run - each costs 1 paid query.
SEARCH_MAX_QUERIES=2
SEARCH_PAGES_PER_QUERY=1
# Hard ceiling on collected sources per task (0 = no cap).
MAX_SOURCES=12
# Stop extracting new pages once this many candidate records exist (0 = off).
EXTRACTION_EARLY_STOP=60

# Optional real search/jobs provider for collectionService's generic collector
SEARCH_PROVIDER=
SEARCH_API_KEY=
