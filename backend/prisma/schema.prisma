generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  DRAFT
  PLANNING
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum ValidationStatus {
  VALID
  INVALID
  PARTIAL
}

model User {
  id        String   @id @default(uuid())
  name      String?
  email     String?  @unique
  createdAt DateTime @default(now())

  tasks Task[]
}

model Task {
  id                     String   @id @default(uuid())
  userId                 String?
  prompt                 String
  status                 TaskStatus @default(DRAFT)
  structuredRequirement  Json?
  jobId                  String?
  retryCount             Int      @default(0)
  cancelRequested        Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user      User?      @relation(fields: [userId], references: [id])
  workflows Workflow[]
  sources   Source[]
  datasets  Dataset[]
  logs      ExecutionLog[]

  @@index([status])
  @@index([createdAt])
}

model Workflow {
  id         String   @id @default(uuid())
  taskId     String
  version    Int      @default(1)
  definition Json
  status     String   @default("PLANNED")
  createdAt  DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model Source {
  id           String    @id @default(uuid())
  taskId       String
  url          String
  type         String
  status       String    @default("PENDING")
  errorMessage String?
  checkedAt    DateTime?
  metadata     Json?
  createdAt    DateTime  @default(now())

  task    Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  records Record[]

  @@index([taskId])
  @@index([url])
  @@index([status])
}

model Dataset {
  id           String   @id @default(uuid())
  taskId       String
  name         String
  version      Int      @default(1)
  usedMockData Boolean  @default(false)
  createdAt    DateTime @default(now())

  task    Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  records Record[]

  @@index([taskId])
}

model Record {
  id               String            @id @default(uuid())
  datasetId        String
  sourceId         String?
  data             Json
  validationStatus ValidationStatus  @default(PARTIAL)
  validationErrors Json?
  confidence       Float?            @default(1.0)
  dedupeKey        String?
  createdAt        DateTime          @default(now())

  dataset Dataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  source  Source? @relation(fields: [sourceId], references: [id])

  @@index([datasetId])
  @@index([sourceId])
  @@index([validationStatus])
  @@index([dedupeKey])
}

model ExecutionLog {
  id        String   @id @default(uuid())
  taskId    String
  step      String
  status    String
  message   String?
  metadata  Json?
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([createdAt])
}
